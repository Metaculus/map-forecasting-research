# Only the LLM-backed tools and the Radiant client need these.
# Default LLM for the tools, "openai:<model>" or "anthropic:<model>" (or pass llm= in code).
# MAP_FORECASTING_LLM=openai:<model>
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # any OpenAI-compatible server, e.g. OpenRouter or a local one
# ANTHROPIC_API_KEY=
# MAP_FORECASTING_CACHE_DIR=~/.cache/map_forecasting
# RADIANT_BASE_URL=
# RADIANT_API_KEY=
